# ============================================================================
# 1. GMAIL SMTP NOTIFICATION SETTINGS
# ============================================================================
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_SENDER=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_RECIPIENT=your.email@gmail.com

# ============================================================================
# 2. TELEGRAM BOT NOTIFICATION SETTINGS (100% Free, Works When Mac Is Locked!)
# 1. Message @BotFather on Telegram -> send /newbot -> copy the Bot Token below
# 2. Open your new bot on Telegram and send "hi" (Chat ID is auto-discovered!)
# ============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================================
# 3. WHATSAPP NOTIFICATION SETTINGS (Optional)
# Choose: "disabled", "callmebot", "twilio", or "meta"
# ============================================================================
